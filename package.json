{
  "name": "consent_admin",
  "version": "0.1.0",
  "private": true,
  "author": "saibrandingarc",
  "description": "Consent Management admin dashboard",
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @cmp/admin dev",
    "build": "pnpm --filter @cmp/types build && pnpm --filter @cmp/utils build && pnpm --filter @cmp/auth build && pnpm --filter @cmp/admin build",
    "start": "pnpm --filter @cmp/admin start",
    "typecheck": "pnpm --filter @cmp/admin typecheck"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "typescript": "^7.0.2"
  }
}
